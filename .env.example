# وجهة أشوس — متغيرات البيئة
# انسخ هذا الملف إلى .env.local محلياً، وأضف القيم نفسها في Cloudflare Worker Secrets/Variables.
# لا تضع أي قيمة حقيقية أو مفتاح سري في GitHub.

# Supabase — عامة، تُضمّن NEXT_PUBLIC_* في حزمة المتصفح وقت البناء
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase — خادم فقط (مفتاح service_role لا يُكشف للمتصفح)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAILS=admin@example.com

# استخراج المواد بالذكاء الاصطناعي — خادم فقط
OPENAI_API_KEY=your-openai-api-key

# Web Push — المفتاح العام يُستخدم في المتصفح، والخاص خادم فقط
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# حماية مهمة Cron الخاصة بفتح كبسولة الزمن
CRON_SECRET=replace-with-a-long-random-secret

# اختياري: أصل الموقع لروابط الرجوع من المصادقة
# NEXT_PUBLIC_SITE_URL=https://your-worker.workers.dev
